# Скопируйте в .env и заполните. .env НЕ коммитить!
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY= 
DATABASE_URL=postgresql://adal:adal@localhost:5432/adal

GEN_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Максимальная косинусная дистанция, при которой фрагмент считается релевантным.
# Меньше = строже. Подберите на своих тестовых вопросах (0.35-0.55).
MAX_DISTANCE=0.45
TOP_K=6

# Telegram user id администраторов через запятую (для /stats)
ADMIN_IDS=
